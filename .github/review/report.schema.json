{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["context", "scope", "tasks", "findings", "mergedCount", "discardedCount", "failureReasons"],
  "properties": {
    "context": { "$ref": "#/$defs/context" },
    "scope": { "$ref": "#/$defs/scope" },
    "tasks": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/task" } },
    "findings": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/finding" } },
    "mergedCount": { "type": "integer", "minimum": 0 },
    "discardedCount": { "type": "integer", "minimum": 0 },
    "failureReasons": { "type": "array", "items": { "type": "string", "maxLength": 4000 } }
  },
  "$defs": {
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "repository", "pr", "baseSha", "headSha", "trustedSha", "rulesHash", "runId", "runAttempt", "runUrl", "model"],
      "properties": {
        "schemaVersion": { "type": "integer", "enum": [1] },
        "repository": { "type": "string" }, "pr": { "type": "integer", "minimum": 1 },
        "baseSha": { "type": "string" }, "headSha": { "type": "string" },
        "trustedSha": { "type": "string" }, "rulesHash": { "type": "string" },
        "runId": { "type": "string" }, "runAttempt": { "type": "string" },
        "runUrl": { "type": "string" }, "model": { "type": "string" }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshotId", "textFileCount", "textFiles"],
      "properties": {
        "snapshotId": { "type": "string" }, "textFileCount": { "type": "integer", "minimum": 0 },
        "textFiles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["rule", "phase", "predecessorTaskId", "rulePath", "taskId", "snapshotId", "modelInherited", "status", "output", "durationMs", "reason"],
      "properties": {
        "rule": { "type": "string", "enum": ["standards", "architect", "devops", "product_contract", "runtime_performance", "security"] },
        "phase": { "type": "string", "enum": ["primary", "verification"] },
        "predecessorTaskId": { "type": ["string", "null"] },
        "rulePath": { "type": "string" }, "taskId": { "type": ["string", "null"] },
        "snapshotId": { "type": ["string", "null"] }, "modelInherited": { "type": "boolean" },
        "status": { "type": "string", "enum": ["completed", "failed", "timed_out", "cancelled", "not_started", "unknown", "invalid_output"] },
        "output": { "type": ["string", "null"], "maxLength": 100000 },
        "durationMs": { "type": ["integer", "null"], "minimum": 0 },
        "reason": { "type": ["string", "null"], "maxLength": 4000 }
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["severity", "title", "file", "line", "code", "trigger", "impact", "evidence", "sourceTaskIds"],
      "properties": {
        "severity": { "type": "string", "enum": ["Critical", "Major", "Minor"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "file": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "line": { "type": "integer", "minimum": 1 },
        "code": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "trigger": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "impact": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "sourceTaskIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
